# ── Swaggers Pizza OMS — copy to .env and fill in ──
NODE_ENV=production
PORT=3000
BASE_URL=https://staff.swaggerspizza.com
# Long random string (e.g. `openssl rand -hex 32`). Changing it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string
TZ_NAME=Africa/Accra
CURRENCY=GHS

# Data locations (defaults to ./data)
# DB_PATH=/var/lib/swaggers/swaggers.db
# UPLOAD_DIR=/var/lib/swaggers/uploads
# BACKUP_DIR=/var/lib/swaggers/backups

# First start on an empty database:
#   SEED_DEMO=false  → real launch: only the Owner account is created (password printed once in the log)
#   SEED_DEMO=true   → loads 30 days of realistic demo data for training / trying the system
SEED_DEMO=false
OWNER_EMAIL=owner@swaggerspizza.com
# Demo accounts all use this one simple password (demo only — never in production):
SEED_PASSWORD=demo123

# Email alerts (critical incidents, daily summary) — any SMTP provider (Google Workspace, Zoho, Mailgun…)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ops@swaggerspizza.com
# SMTP_PASS=app-password
# SMTP_FROM="Swaggers Pizza Ops <ops@swaggerspizza.com>"

# SMS alerts for CRITICAL incidents — the portal POSTs JSON {to, message} to this URL.
# Point it at a small adapter for Hubtel / Arkesel / mNotify.
# SMS_WEBHOOK_URL=https://your-sms-adapter.example.com/send
# SMS_WEBHOOK_TOKEN=

# "Ask Swaggers" AI assistant + AI daily summary (Claude). Leave empty to use handbook search only.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
