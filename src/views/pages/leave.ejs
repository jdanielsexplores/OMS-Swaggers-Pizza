<div class="page-head"><div><h1>Leave &amp; late permission</h1><p>Request leave at least 7 days ahead (SOP-19). A <b>late permission</b> lets you arrive by an agreed time without being marked late — approving it recalculates that day automatically.</p></div></div>
<div class="grid g3">
  <div class="card"><h3>New request</h3><form method="post" action="/leave" class="form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (staff.length) { %><div><label>For <span class="hint">(managers can record leave directly)</span></label><select name="user_id"><option value="">Myself (needs approval)</option><% for (const s of staff) { %><option value="<%= s.id %>"><%= s.name %></option><% } %></select></div><% } %>
    <div><label>Type</label><select name="leave_type" id="lt" onchange="document.getElementById('untilRow').hidden=this.value!=='late_permission';document.getElementById('endRow').hidden=this.value==='late_permission'"><option value="annual">Annual leave</option><option value="sick">Sick leave</option><option value="late_permission">Late permission</option><option value="compassionate">Compassionate</option><option value="unpaid">Unpaid</option><option value="other">Other</option></select></div>
    <div class="form-row"><div><label>Date / from</label><input type="date" name="start_date" required></div><div id="endRow"><label>To</label><input type="date" name="end_date"></div><div id="untilRow" hidden><label>Arrive by</label><input type="time" name="until_time"></div></div>
    <div><label>Reason</label><textarea name="reason" style="min-height:70px"></textarea></div><button class="btn primary">Submit</button></form></div>
  <div class="card span2 flush"><div class="card-head"><h3>My requests</h3></div><div class="table-wrap"><table class="table responsive"><thead><tr><th>Type</th><th>Dates</th><th>Reason</th><th>Status</th></tr></thead><tbody>
    <% for (const l of mine) { %><tr><td data-label="Type"><b><%= titleCase(l.leave_type) %></b></td><td data-label="Dates"><%= fmtDate(l.start_date) %><%= l.end_date !== l.start_date ? ' → ' + fmtDate(l.end_date) : '' %><%= l.until_time ? ' · arrive by ' + l.until_time : '' %></td><td data-label="Reason" class="small"><%= l.reason || '' %></td><td data-label="Status"><%- badge(l.status) %></td></tr><% } %>
  </tbody></table></div><% if (!mine.length) { %><div class="empty">No requests yet.</div><% } %><%- include('../partials/pager', { p: mp }) %></div>
</div>
<% if (tp) { %>
<div class="card flush" style="margin-top:18px" id="team"><div class="card-head"><h3>Team requests</h3><span class="small muted">Pending first</span></div>
<form class="filterbar" method="get" style="margin:12px 20px;box-shadow:none">
  <div><label>Status</label><select name="tstatus"><option value="">Any</option><% for (const s of ['pending','approved','rejected']) { %><option value="<%= s %>" <%= selected(tf.tstatus, s) %>><%= titleCase(s) %></option><% } %></select></div>
  <div><label>Type</label><select name="ttype"><option value="">Any</option><% for (const s of ['annual','sick','late_permission','compassionate','unpaid','other']) { %><option value="<%= s %>" <%= selected(tf.ttype, s) %>><%= titleCase(s) %></option><% } %></select></div>
  <div><label>Staff</label><select name="tstaff"><option value="">Everyone</option><% for (const u of people) { %><option value="<%= u.id %>" <%= selected(tf.tstaff, u.id) %>><%= u.name %></option><% } %></select></div>
  <div><label>From</label><input type="date" name="tfrom" value="<%= tf.tfrom %>"></div><div><label>To</label><input type="date" name="tto" value="<%= tf.tto %>"></div>
  <div class="fb-actions"><button class="btn primary sm">Filter</button><a class="btn sm" href="/leave">Reset</a></div></form><div class="table-wrap"><table class="table responsive"><thead><tr><th>Staff</th><th>Type</th><th>Dates</th><th>Reason</th><th>Status</th><th></th></tr></thead><tbody>
<% for (const l of team) { %><tr><td data-label="Staff"><b><%= l.name %></b></td><td data-label="Type"><%= titleCase(l.leave_type) %></td><td data-label="Dates"><%= fmtDate(l.start_date) %><%= l.end_date !== l.start_date ? ' → ' + fmtDate(l.end_date) : '' %><%= l.until_time ? ' · by ' + l.until_time : '' %></td><td data-label="Reason" class="small"><%= l.reason || '' %></td><td data-label="Status"><%- badge(l.status) %></td>
<td><% if (l.status === 'pending' && can('leave.decide') && l.user_id !== user.id) { %><form method="post" action="/leave/<%= l.id %>/decide" class="actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn sm ok" name="decision" value="approve">Approve</button><button class="btn sm" name="decision" value="reject">Reject</button></form><% } %></td></tr><% } %>
</tbody></table></div><% if (!team.length) { %><div class="empty">No requests match.</div><% } %><%- include('../partials/pager', { p: tp, hash: 'team' }) %></div>
<% } %>
