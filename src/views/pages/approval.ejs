<div class="card" style="max-width:760px"><div class="card-head"><h2><%= a.title %></h2><%- badge(a.status) %></div>
  <dl class="dl"><dt>Type</dt><dd><%= titleCase(a.kind) %></dd><dt>Requested by</dt><dd><%= a.requester %> · <%= fmtDateTime(a.created_at) %></dd><dt>Decided by</dt><dd><%= a.required_role === 'owner' ? 'Owner' : 'Operations Manager (or Owner)' %></dd><% if (a.amount) { %><dt>Amount</dt><dd><%= money(a.amount) %></dd><% } %></dl>
  <% if (a.details) { %><p style="white-space:pre-wrap;margin-top:12px"><%= a.details %></p><% } %>
  <% if (context && a.kind === 'price_change') { %><div class="callout">Current price <b><%= money(context.price) %></b> → proposed <b><%= money(context.new_price) %></b> · unit cost <%= money(context.unit_cost) %> · new gross margin <b><%= pct((context.new_price - context.unit_cost) / context.new_price * 100) %></b> (was <%= pct((context.price - context.unit_cost) / context.price * 100) %>)</div><% } %>
  <% if (context && a.kind === 'refund') { %><div class="callout">Case <a href="/customers/<%= context.case_id %>"><%= context.ref %></a>: <%= context.description %> · reason: <%= context.reason %></div><% } %>
  <% if (context && a.kind === 'expense') { %><div class="callout"><%= context.category %> · <%= context.description %> · <%= fmtDate(context.txn_date) %></div><% } %>
  <% if (a.decided_at) { %><p class="muted">Decision by <%= a.decider %> on <%= fmtDateTime(a.decided_at) %><%= a.decision_notes ? ': "' + a.decision_notes + '"' : '' %></p><% } %>
  <% if (canDecide) { %><form method="post" action="/approvals/<%= a.id %>" class="form" style="margin-top:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><textarea name="notes" placeholder="Notes (optional)"></textarea><div class="actions"><button class="btn ok" name="decision" value="approve">Approve</button><button class="btn danger" name="decision" value="reject">Reject</button></div></form>
  <% } else if (a.status === 'pending') { %><p class="small muted">Waiting for <%= a.required_role === 'owner' ? 'the Owner' : 'a manager' %>. You cannot approve your own request.</p><% } %></div>
