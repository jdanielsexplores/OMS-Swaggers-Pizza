<div class="card" style="max-width:820px">
  <h2><%= site.id ? 'Edit site' : 'New site' %></h2>
  <form method="post" action="<%= site.id ? '/sites/' + site.id : '/sites' %>" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-row">
      <% if (!site.id) { %><div><label>Site code <span class="hint">(3–6 letters, e.g. KIA)</span></label><input name="code" required maxlength="6" style="text-transform:uppercase"></div><% } %>
      <div style="grid-column:span 2"><label>Site name</label><input name="name" value="<%= site.name || '' %>" required></div>
    </div>
    <div class="form-row">
      <div><label>Location type</label><select name="type"><% for (const t of ['airport','mall','office','school','other']) { %><option <%= selected(site.type, t) %> value="<%= t %>"><%= titleCase(t) %></option><% } %></select></div>
      <div><label>Status</label><select name="status"><% for (const t of ['planning','active','paused','closed']) { %><option <%= selected(site.status, t) %> value="<%= t %>"><%= titleCase(t) %></option><% } %></select></div>
      <div><label>Opens</label><input type="time" name="opening_time" value="<%= site.opening_time || '' %>"></div>
      <div><label>Closes</label><input type="time" name="closing_time" value="<%= site.closing_time || '' %>"></div>
    </div>
    <div class="form-row"><div><label>Address / position in site</label><input name="address" value="<%= site.address || '' %>"></div><div><label>City / area</label><input name="city" value="<%= site.city || '' %>"></div></div>
    <div class="form-row"><div><label>Site contact (landlord / facilities)</label><input name="contact_name" value="<%= site.contact_name || '' %>"></div><div><label>Contact phone</label><input name="contact_phone" value="<%= site.contact_phone || '' %>"></div></div>
    <div class="card" style="background:var(--line-2);box-shadow:none"><b class="small">Geofence for clock-in</b><p class="small muted" style="margin:4px 0 10px">Staff must be within this radius to clock in or out. Stand at the machine and tap "Use my location".</p>
      <div class="form-row"><div><label>Latitude</label><input name="latitude" id="lat" value="<%= site.latitude ?? '' %>" inputmode="decimal"></div><div><label>Longitude</label><input name="longitude" id="lng" value="<%= site.longitude ?? '' %>" inputmode="decimal"></div><div><label>Radius (metres)</label><input type="number" name="geofence_radius_m" value="<%= site.geofence_radius_m || 150 %>"></div>
      <div style="align-self:end"><button type="button" class="btn" onclick="navigator.geolocation.getCurrentPosition(p=>{lat.value=p.coords.latitude.toFixed(6);lng.value=p.coords.longitude.toFixed(6)},e=>alert('Could not get location: '+e.message),{enableHighAccuracy:true})"><%- icon('pin') %>Use my location</button></div></div></div>
    <div><label>Emergency contacts</label><input name="emergency_contact" value="<%= site.emergency_contact || 'Fire 192 · Ambulance 193 · Police 191 · Site security' %>"></div>
    <div><label>Notes (access rules, loading bay, delivery times…)</label><textarea name="notes"><%= site.notes || '' %></textarea></div>
    <% if (!site.id) { %>
      <div class="card" style="background:var(--brand-50)">
        <label class="check"><input type="checkbox" name="request_approval" value="1" checked> Send to Owner for approval (new site)</label>
        <div class="form-row" style="margin-top:10px"><div><label>Estimated investment (GHS)</label><input type="number" name="investment" step="0.01"></div></div>
        <div style="margin-top:10px"><label>Business case (expected sales, rent/commission, payback)</label><textarea name="business_case"></textarea></div>
      </div>
    <% } %>
    <div><button class="btn primary">Save site</button></div>
  </form>
</div>
