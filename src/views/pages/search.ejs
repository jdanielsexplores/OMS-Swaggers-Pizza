<div class="page-head"><div><h1>Search</h1><p><%= q ? 'Results for "' + q + '"' : 'Type at least 2 characters.' %></p></div></div>
<form class="filters" action="/search"><input type="search" name="q" value="<%= q %>" placeholder="Search…" style="min-width:320px;flex:1" autofocus><button class="btn primary">Search</button></form>
<% const total = Object.values(out).reduce((a, x) => a + x.length, 0); %>
<% if (q && !total) { %><div class="card empty">Nothing found. Try a machine code, device number, staff name, SOP code or incident reference.</div><% } %>
<div class="grid g2">
<% if (out.machines.length) { %><div class="card"><h3>Machines</h3><% for (const m of out.machines) { %><div class="row-item"><span class="status-dot <%= m.status %>"></span><div class="grow"><a href="/machines/<%= m.id %>"><b><%= m.code %></b></a><div class="small muted"><%= m.site_name %> <%= m.supplier_device_no ? '· ' + m.supplier_device_no : '' %></div></div><%- badge(m.status) %></div><% } %></div><% } %>
<% if (out.staff.length) { %><div class="card"><h3>Staff</h3><% for (const u of out.staff) { %><div class="row-item"><div class="avatar" style="width:32px;height:32px;font-size:12px"><%= u.name.split(' ').map(w => w[0]).slice(0,2).join('') %></div><div class="grow"><a href="/users/<%= u.id %>"><b><%= u.name %></b></a><div class="small muted"><%= roleLabel(u.role) %> · <%= u.staff_no %></div></div></div><% } %></div><% } %>
<% if (out.incidents.length) { %><div class="card"><h3>Incidents</h3><% for (const i of out.incidents) { %><div class="row-item"><%- badge(i.severity) %><div class="grow"><a href="/incidents/<%= i.id %>"><b><%= i.title %></b></a><div class="small muted"><%= i.ref %></div></div><%- badge(i.status) %></div><% } %></div><% } %>
<% if (out.sops.length) { %><div class="card"><h3>Handbook</h3><% for (const s of out.sops) { %><div class="row-item"><span class="sop-code"><%= s.code %></span><div class="grow"><a href="/handbook/<%= s.code %>"><b><%= s.title %></b></a><div class="small muted"><%= s.purpose %></div></div></div><% } %></div><% } %>
<% if (out.sites.length) { %><div class="card"><h3>Sites</h3><% for (const s of out.sites) { %><div class="row-item"><span class="ico"><%- icon('map') %></span><div class="grow"><a href="/sites/<%= s.id %>"><b><%= s.name %></b></a><div class="small muted"><%= titleCase(s.type) %></div></div></div><% } %></div><% } %>
</div>
