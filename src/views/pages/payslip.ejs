<div class="card" style="max-width:720px">
  <div class="card-head"><div class="product-tile"><img src="<%= brand.logo %>" alt="" style="border-radius:12px;background:#fff;object-fit:contain"><div><b style="font-family:var(--display);font-size:1.2rem"><%= businessName %></b><div class="small muted">Payslip · <%= i.month %> <%= i.status !== 'finalized' ? '(DRAFT)' : '' %></div></div></div><button class="btn sm no-print" onclick="print()">Print / PDF</button></div>
  <dl class="dl"><dt>Employee</dt><dd><%= i.name %> (<%= i.staff_no %>)</dd><dt>Role</dt><dd><%= roleLabel(i.role) %></dd><dt>Pay basis</dt><dd><%= titleCase(i.pay_type) %></dd><% if (i.bank_details) { %><dt>Paid to</dt><dd><%= i.bank_details %></dd><% } %></dl>
  <hr>
  <div class="grid g2">
    <div><div class="eyebrow" style="margin-bottom:8px">Attendance</div><table class="table"><tr><td>Scheduled days</td><td class="num"><%= i.scheduled_days %></td></tr><tr><td>Days worked</td><td class="num"><%= i.worked_days %></td></tr><tr><td>Approved leave</td><td class="num"><%= i.leave_days %></td></tr><tr><td>Absences</td><td class="num"><%= i.absent_days %></td></tr><tr><td>Late minutes</td><td class="num"><%= i.late_minutes %></td></tr><tr><td>Overtime hours</td><td class="num"><%= i.overtime_hours %></td></tr><% if (d.workedHours != null) { %><tr><td>Hours worked</td><td class="num"><%= d.workedHours %></td></tr><% } %></table></div>
    <div><div class="eyebrow" style="margin-bottom:8px">Earnings &amp; deductions</div><table class="table"><tr><td>Basic pay</td><td class="num"><%= money(i.base_pay) %></td></tr><tr><td>Allowances</td><td class="num"><%= money(i.allowances) %></td></tr><tr><td>Overtime</td><td class="num"><%= money(i.overtime_pay) %></td></tr><tr><td><b>Gross</b></td><td class="num"><b><%= money(i.gross) %></b></td></tr><tr><td>Absences</td><td class="num">−<%= money(i.absence_deduction) %></td></tr><tr><td>Lateness</td><td class="num">−<%= money(i.late_deduction) %></td></tr><tr><td>SSNIT</td><td class="num">−<%= money(i.ssnit) %></td></tr><tr><td>Other</td><td class="num">−<%= money(i.other_deductions) %></td></tr></table></div>
  </div>
  <div class="callout ok" style="display:flex;justify-content:space-between;align-items:center"><b>Net pay</b><b style="font-family:var(--display);font-size:1.5rem"><%= money(i.net) %></b></div>
  <% if (d.absences && d.absences.length) { %><p class="small muted">Absent on: <%= d.absences.join(', ') %></p><% } %>
</div>
