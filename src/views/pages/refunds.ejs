<div class="page-head"><div><h1>Refunds</h1><p>Approved in Approvals; paid by Accounts with a provider reference.</p></div></div>
<form class="filterbar" method="get">
  <div><label>Search</label><input type="search" name="q" value="<%= f.q %>" placeholder="Case ref, reason, paid ref"></div>
  <div><label>Status</label><select name="status"><option value="">Any</option><% for (const st of ['pending','approved','paid','rejected']) { %><option value="<%= st %>" <%= selected(f.status, st) %>><%= titleCase(st) %></option><% } %></select></div>
  <div><label>From</label><input type="date" name="from" value="<%= f.from %>"></div><div><label>To</label><input type="date" name="to" value="<%= f.to %>"></div>
  <div class="fb-actions"><button class="btn primary sm">Filter</button><a class="btn sm" href="/customers/refunds">Reset</a></div></form>
<div class="card flush"><div class="table-wrap"><table class="table responsive"><thead><tr><th>Case</th><th class="num">Amount</th><th>Reason</th><th>Requested</th><th>Status</th><th></th></tr></thead><tbody>
<% for (const r of rows) { %><tr><td data-label="Case"><a href="/customers/<%= r.case_id %>"><%= r.case_ref || '—' %></a><div class="small muted"><%= r.site_name || '' %></div></td><td class="num" data-label="Amount"><%= money(r.amount) %></td><td data-label="Reason" class="small"><%= r.reason || '' %></td><td data-label="Requested" class="small"><%= r.requester %> · <%= ago(r.created_at) %></td><td data-label="Status"><%- badge(r.status) %><div class="small muted"><%= r.approver ? 'by ' + r.approver : '' %> <%= r.paid_ref ? '· ' + r.paid_ref : '' %></div></td>
<td><% if (r.status === 'approved' && can('refunds.pay')) { %><form method="post" action="/customers/refunds/<%= r.id %>/pay" style="display:flex;gap:4px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="paid_ref" placeholder="Provider ref" style="padding:5px;min-width:120px" required><button class="btn sm ok">Mark paid</button></form><% } else if (r.status === 'pending') { %><a class="small" href="/approvals">Awaiting approval</a><% } %></td></tr><% } %>
</tbody></table></div><% if (!rows.length) { %><div class="empty">No refunds match.</div><% } %><%- include('../partials/pager', { p }) %></div>
