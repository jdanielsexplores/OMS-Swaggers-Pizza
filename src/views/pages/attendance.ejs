<div class="page-head"><div><h1>Attendance</h1><p>Clock-in and clock-out use <b>server time</b> (Africa/Accra) and are checked against each site's geofence on the server. Lateness and overtime are calculated by one rules engine.</p></div>
  <div class="actions"><a class="btn" href="/leave">Leave &amp; late permission</a></div></div>

<div class="kpis">
  <div class="kpi"><span class="chip"><%- icon('calendar') %></span><div class="label">My attendance (month)</div><div class="value"><%= myMonth.scheduled ? Math.round(myMonth.worked / myMonth.scheduled * 100) + '%' : '—' %></div><div class="sub"><%= myMonth.worked %>/<%= myMonth.scheduled %> scheduled days</div></div>
  <div class="kpi <%= myMonth.absent ? 'warn' : 'ok' %>"><div class="label">Absences</div><div class="value"><%= myMonth.absent %></div><div class="sub"><%= myMonth.leave %> on approved leave</div></div>
  <div class="kpi <%= myMonth.late > 30 ? 'warn' : '' %>"><div class="label">Late (month)</div><div class="value"><%= myMonth.late %>m</div></div>
  <div class="kpi"><div class="label">Overtime (month)</div><div class="value"><%= myMonth.ot %>h</div><div class="sub">after 8h + 1h grace, whole hours</div></div>
</div>

<% if (team) { %>
<% if (missing.length) { %><div class="card" style="border-color:var(--bad);margin-bottom:18px"><h3 style="color:var(--bad)">Rostered but not clocked in · <%= fmtDate(date) %></h3>
  <% for (const m of missing) { %><div class="row-item"><span class="ico" style="background:var(--bad-bg);color:var(--bad)"><%- icon('user') %></span><div class="grow"><b><%= m.name %></b> · <%= m.site_name %><div class="small muted"><%= m.start_time %>–<%= m.end_time %></div></div><%- badge(m.status) %></div><% } %></div><% } %>

<div class="card flush" id="team"><div class="card-head"><h3>Team attendance</h3><span class="small muted"><%= tf.date_from || tf.date_to ? fmtDate(tf.date_from || date) + ' → ' + fmtDate(tf.date_to || date) : fmtDate(date) %></span></div>
<form class="filterbar" method="get" style="margin:12px 20px;box-shadow:none"><input type="hidden" name="mfrom" value="<%= mf.mfrom %>"><input type="hidden" name="mto" value="<%= mf.mto %>">
  <div><label>Day</label><input type="date" name="date" value="<%= date %>" data-default="<%= today() %>"></div>
  <div><label>Or from</label><input type="date" name="date_from" value="<%= tf.date_from %>"></div><div><label>to</label><input type="date" name="date_to" value="<%= tf.date_to %>"></div>
  <div><label>Name</label><input type="search" name="q" value="<%= tf.q %>" placeholder="Staff name"></div>
  <div><label>Staff</label><select name="staff"><option value="">Everyone</option><% for (const s of staff) { %><option value="<%= s.id %>" <%= selected(tf.staff, s.id) %>><%= s.name %></option><% } %></select></div>
  <div><label>Site</label><select name="site"><option value="">All</option><% for (const s of sites) { %><option value="<%= s.id %>" <%= selected(tf.site, s.id) %>><%= s.name %></option><% } %></select></div>
  <div><label>Punctuality</label><select name="punctuality"><option value="">Any</option><option value="late" <%= selected(tf.punctuality, 'late') %>>Late</option><option value="ontime" <%= selected(tf.punctuality, 'ontime') %>>On time</option></select></div>
  <div><label>Record</label><select name="state"><option value="">Any</option><option value="open" <%= selected(tf.state, 'open') %>>Still on shift</option><option value="ot" <%= selected(tf.state, 'ot') %>>With overtime</option><option value="auto" <%= selected(tf.state, 'auto') %>>Auto clock-out</option><option value="manual" <%= selected(tf.state, 'manual') %>>Added by manager</option></select></div>
  <div class="fb-actions"><button class="btn primary sm">Filter</button><a class="btn sm" href="/attendance">Reset</a></div>
</form>
<div class="table-wrap"><table class="table responsive"><thead><tr><th>Staff</th><th>Site</th><th>Start</th><th>In</th><th>Out</th><th class="num">Worked</th><th>Late</th><th class="num">OT</th><th>Location</th><% if (can('attendance.manage')) { %><th></th><% } %></tr></thead><tbody>
<% for (const a of rows) { const fl = a.flags ? JSON.parse(a.flags) : {}; %>
<tr><td data-label="Staff"><b><%= a.name %></b><div class="small muted"><%= fmtDate(a.work_date || a.clock_in, {year:false}) %> · <%= roleLabel(a.role) %><%= a.source !== 'self' ? ' · ' + titleCase(a.source) : '' %></div></td><td data-label="Site"><%= a.site_name || '—' %></td>
<td data-label="Start"><%= a.effective_start || a.scheduled_start || '—' %><% if (a.effective_start && a.scheduled_start && a.effective_start !== a.scheduled_start) { %><div class="small muted">late permission</div><% } %></td>
<td data-label="In" class="mono"><%= fmtTime(a.clock_in) %></td><td data-label="Out" class="mono"><%- a.clock_out ? fmtTime(a.clock_out) : badge('ok','On shift') %></td>
<td class="num" data-label="Worked"><%= a.worked_minutes == null ? '—' : Math.floor(a.worked_minutes / 60) + 'h ' + String(a.worked_minutes % 60).padStart(2, '0') + 'm' %></td>
<td data-label="Late"><%- a.late_minutes ? badge('warn', a.late_minutes + ' min') : badge('ok','On time') %></td>
<td class="num" data-label="OT"><%= a.overtime_hours || 0 %>h<%= a.overtime_override != null ? '*' : '' %></td>
<td data-label="Location" class="small"><%= a.in_distance_m != null ? a.in_distance_m + ' m from site' : (a.in_lat ? 'GPS recorded' : '—') %><% if (fl.warn) { %><div style="color:var(--warn)">⚠ <%= fl.warn %></div><% } %><% if (fl.auto_clockout) { %><div style="color:var(--warn)">Auto clock-out 23:59</div><% } %></td>
<% if (can('attendance.manage')) { %><td><details><summary class="btn sm">Edit</summary><form method="post" action="/hr/attendance/<%= a.id %>" class="form" style="min-width:230px;margin-top:6px"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-row"><div><label>In</label><input type="time" name="clock_in" value="<%= a.clock_in.slice(11,16) %>"></div><div><label>Out</label><input type="time" name="clock_out" value="<%= a.clock_out ? a.clock_out.slice(11,16) : '' %>"></div></div>
  <div><label>Overtime override (h)</label><input type="number" min="0" name="overtime_override" value="<%= a.overtime_override ?? '' %>" placeholder="leave blank = calculated"></div>
  <input name="reason" placeholder="Reason (required, audited)" required>
  <div class="actions"><button class="btn sm primary" name="action" value="save">Save</button><button class="btn sm danger" name="action" value="delete" onclick="return confirm('Delete this attendance record?')">Delete</button></div></form></details></td><% } %></tr>
<% } %></tbody></table></div><% if (!rows.length) { %><div class="empty">No attendance matches these filters.</div><% } %><%- include('../partials/pager', { p: tp, hash: 'team' }) %></div>

<% if (can('attendance.manage')) { %>
<details class="card" style="margin-top:18px"><summary><b>+ Add an attendance record manually</b> <span class="small muted">— e.g. phone died, forgot to clock in. Every change is audited.</span></summary>
  <form method="post" action="/hr/attendance" class="form" style="margin-top:14px"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-row"><div><label>Staff</label><select name="user_id"><% for (const s of staff) { %><option value="<%= s.id %>"><%= s.name %></option><% } %></select></div><div><label>Site</label><select name="site_id"><% for (const s of sites) { %><option value="<%= s.id %>"><%= s.name %></option><% } %></select></div>
      <div><label>Date</label><input type="date" name="date" value="<%= date %>" required></div><div><label>In</label><input type="time" name="clock_in" required></div><div><label>Out</label><input type="time" name="clock_out"></div></div>
    <div><label>Reason</label><input name="reason" required></div>
    <label class="check"><input type="checkbox" name="override_duplicate" value="1"> Allow a second record for the same day (explicit override)</label>
    <div><button class="btn primary">Add record</button></div></form></details>
<% } %>
<% } %>

<div class="card flush" style="margin-top:18px" id="mine"><div class="card-head"><h3>My attendance history</h3></div>
<form class="filterbar" method="get" style="margin:12px 20px;box-shadow:none"><% for (const k of ['date','date_from','date_to','staff','site','punctuality','state','q']) { if (query[k]) { %><input type="hidden" name="<%= k %>" value="<%= query[k] %>"><% } } %>
  <div><label>From</label><input type="date" name="mfrom" value="<%= mf.mfrom %>"></div><div><label>To</label><input type="date" name="mto" value="<%= mf.mto %>"></div>
  <div><label>Show</label><select name="mlate"><option value="">All days</option><option value="1" <%= selected(mf.mlate, '1') %>>Late days only</option></select></div>
  <div class="fb-actions"><button class="btn primary sm">Filter</button></div></form>
<div class="table-wrap"><table class="table responsive"><thead><tr><th>Date</th><th>Site</th><th>In</th><th>Out</th><th class="num">Worked</th><th>Late</th><th class="num">OT</th></tr></thead><tbody>
<% for (const a of mine) { %><tr><td data-label="Date"><%= fmtDate(a.work_date || a.clock_in) %></td><td data-label="Site"><%= a.site_name || '—' %></td><td data-label="In" class="mono"><%= fmtTime(a.clock_in) %></td><td data-label="Out" class="mono"><%= a.clock_out ? fmtTime(a.clock_out) : 'on shift' %></td><td class="num" data-label="Worked"><%= a.worked_minutes == null ? '—' : Math.floor(a.worked_minutes / 60) + 'h ' + String(a.worked_minutes % 60).padStart(2, '0') + 'm' %></td><td data-label="Late"><%- a.late_minutes ? badge('warn', a.late_minutes + ' min') : badge('ok','On time') %></td><td class="num" data-label="OT"><%= a.overtime_hours || 0 %>h</td></tr><% } %>
</tbody></table></div><% if (!mine.length) { %><div class="empty">No attendance found.</div><% } %><%- include('../partials/pager', { p: mp, hash: 'mine' }) %></div>
