<div class="page-head"><div><h1>Checklist templates</h1><p>Change what staff check without touching code. Every change bumps the template version.</p></div><a class="btn primary" href="/checklists/templates/new"><%- icon('plus') %>New template</a></div>
<div class="card flush"><div class="table-wrap"><table class="table responsive"><thead><tr><th>Template</th><th>Category</th><th>Frequency</th><th>Due</th><th>Site type</th><th class="num">Items</th><th>v</th><th>Status</th></tr></thead><tbody>
<% for (const t of templates) { %><tr><td data-label="Template"><a href="/checklists/templates/<%= t.id %>"><b><%= t.name %></b></a></td><td data-label="Category"><%= titleCase(t.category) %></td><td data-label="Frequency"><%= titleCase(t.frequency) %></td><td data-label="Due"><%= t.due_time || '—' %></td><td data-label="Site type"><%= t.site_type ? titleCase(t.site_type) : 'All' %></td><td class="num" data-label="Items"><%= t.items %></td><td data-label="v"><%= t.version %></td><td data-label="Status"><%- t.active ? badge('active') : badge('closed','Inactive') %></td></tr><% } %>
</tbody></table></div></div>
