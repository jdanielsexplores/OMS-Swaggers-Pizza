<div class="card" style="max-width:820px"><h2>New customer case (SOP-08)</h2>
<div class="callout">Say: "I'm sorry this happened. I'll record it and contact the right person to help." Never record a PIN, OTP, password or full card number. Collect contact details only if needed to resolve the case.</div>
<form method="post" action="/customers" class="form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-row"><div><label>Category</label><select name="category"><% for (const c of CATS) { %><option value="<%= c %>"><%= titleCase(c) %></option><% } %></select></div><div><label>Channel</label><select name="channel"><option value="in_person">In person</option><option value="phone">Phone</option><option value="social">Social media</option><option value="email">Email</option></select></div><div><label>Rating (optional)</label><select name="rating"><option value="">—</option><% for (let i = 5; i >= 1; i--) { %><option value="<%= i %>"><%= '★'.repeat(i) %></option><% } %></select></div></div>
  <div class="form-row"><div><label>Machine</label><select name="machine_id"><% for (const m of machines) { %><option value="<%= m.id %>"><%= m.code %> — <%= m.site_name %></option><% } %></select></div><div><label>Flavour</label><select name="product_id"><option value="">—</option><% for (const p of products) { %><option value="<%= p.id %>"><%= p.name %></option><% } %></select></div></div>
  <div><label>What happened? (customer's words)</label><textarea name="description" required></textarea></div>
  <div class="form-row"><div><label>Order ID</label><input name="order_ref"></div><div><label>Payment reference</label><input name="payment_ref"></div></div>
  <div class="form-row"><div><label>Customer name <span class="hint">(only if needed)</span></label><input name="customer_name"></div><div><label>Phone / email <span class="hint">(only if needed)</span></label><input name="customer_contact"></div></div>
  <div><button class="btn primary">Record case</button></div></form></div>
