<div class="page-head"><div><h1>Suppliers & technicians</h1><p>Approved suppliers, payment provider, logistics and service contacts with response targets.</p></div></div>
<form class="filterbar" method="get"><div><label>Search</label><input type="search" name="q" value="<%= f.q %>" placeholder="Name, contact, phone"></div>
  <div><label>Type</label><select name="category"><option value="">All</option><% for (const c of ['technician','food_supplier','packaging','payment_provider','logistics','cleaning','other']) { %><option value="<%= c %>" <%= selected(f.category, c) %>><%= titleCase(c) %></option><% } %></select></div>
  <div><label>Approved</label><select name="approved"><option value="">Any</option><option value="yes" <%= selected(f.approved, 'yes') %>>Yes</option><option value="no" <%= selected(f.approved, 'no') %>>No</option></select></div>
  <div class="fb-actions"><button class="btn primary sm">Filter</button><a class="btn sm" href="/admin/vendors">Reset</a></div></form>
<div class="grid g3">
  <div class="card span2 flush"><div class="table-wrap"><table class="table responsive"><thead><tr><th>Name</th><th>Type</th><th>Contact</th><th class="num">SLA</th><th class="num">Jobs</th><th class="num">Spend</th><th></th></tr></thead><tbody>
  <% for (const v of vendors) { %><tr><td data-label="Name"><b><%= v.name %></b> <%- v.approved ? '' : badge('pending','Not approved') %><div class="small muted"><%= v.notes || '' %></div></td><td data-label="Type"><%= titleCase(v.category) %></td><td data-label="Contact" class="small"><%= v.contact_name || '' %><br><%= v.phone || '' %> <%= v.email || '' %></td><td class="num" data-label="SLA"><%= v.sla_hours ? v.sla_hours + 'h' : '—' %></td><td class="num" data-label="Jobs"><%= v.jobs %></td><td class="num" data-label="Spend"><%= money(v.spend, 0) %></td>
  <td><details><summary class="btn sm">Edit</summary><form method="post" class="form" style="min-width:240px;margin-top:6px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= v.id %>"><input name="name" value="<%= v.name %>"><input name="category" value="<%= v.category %>"><input name="contact_name" value="<%= v.contact_name || '' %>" placeholder="Contact"><input name="phone" value="<%= v.phone || '' %>" placeholder="Phone"><input name="email" value="<%= v.email || '' %>" placeholder="Email"><input type="number" name="sla_hours" value="<%= v.sla_hours || '' %>" placeholder="SLA hours"><textarea name="notes"><%= v.notes || '' %></textarea><label class="check"><input type="checkbox" name="approved" value="1" <%= checked(v.approved) %>> Approved</label><button class="btn sm primary">Save</button></form></details></td></tr><% } %></tbody></table></div><% if (!vendors.length) { %><div class="empty">No suppliers match.</div><% } %><%- include('../partials/pager', { p }) %></div>
  <div class="card"><h3>Add</h3><form method="post" class="form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" placeholder="Company name" required>
    <select name="category"><% for (const c of ['technician','food_supplier','packaging','payment_provider','logistics','cleaning','other']) { %><option value="<%= c %>"><%= titleCase(c) %></option><% } %></select>
    <input name="contact_name" placeholder="Contact person"><input name="phone" placeholder="Phone"><input type="email" name="email" placeholder="Email"><input type="number" name="sla_hours" placeholder="Response target (hours)"><textarea name="notes" placeholder="Notes (contract, warranty…)"></textarea><label class="check"><input type="checkbox" name="approved" value="1" checked> Approved supplier</label><button class="btn primary">Add</button></form></div>
</div>
