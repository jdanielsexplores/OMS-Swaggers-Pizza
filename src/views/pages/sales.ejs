<%- CHART_JS %>
<div class="page-head"><div><h1>Sales &amp; Cash-up</h1><p>Live sales come from the supplier's machine portal. Each day, record every machine's figures from it here, attach a screenshot, and Accounts reconciles them with Mobile Money settlements.</p></div>
  <div class="actions">
    <% if (can('machine_portal.open')) { %><a class="btn" href="<%= machinePortalUrl %>" target="_blank" rel="noopener"><%- icon('monitor') %>Open machine portal ↗</a><% } %>
    <a class="btn <%= openPE ? '' : '' %>" href="/payments">Payment exceptions <% if (openPE) { %><span class="badge bad"><%= openPE %></span><% } %></a>
    <% if (can('sales.record')) { %><a class="btn primary" href="/sales/cashup"><%- icon('plus') %>Record cash-up</a><% } %>
  </div></div>

<% if (missing.length && can('sales.record')) { %>
<div class="callout"><b>Missing cash-ups for <%= fmtDate(yesterday) %>:</b> <% missing.forEach((m, i) => { %><a href="/sales/cashup?machine=<%= m.id %>&date=<%= yesterday %>"><%= m.code %></a><%= i < missing.length - 1 ? ', ' : '' %><% }) %>. Open the machine portal, read each machine's income and orders, then record them.</div>
<% } %>

<form class="filters" method="get"><div><label>From</label><input type="date" name="from" value="<%= from %>"></div><div><label>To</label><input type="date" name="to" value="<%= to %>"></div>
  <div><label>Site</label><select name="site"><option value="">All my sites</option><% for (const s of sites) { %><option value="<%= s.id %>" <%= selected(site, s.id) %>><%= s.name %></option><% } %></select></div><button class="btn">Apply</button></form>

<div class="kpis">
  <div class="kpi"><span class="chip"><%- icon('cash') %></span><div class="label">Machine income</div><div class="value"><%= money(totals.income, 0) %></div><div class="sub">from supplier portal · <%= totals.n %> cash-ups</div></div>
  <div class="kpi"><span class="chip"><%- icon('pizza') %></span><div class="label">Orders</div><div class="value"><%= num(totals.orders) %></div><div class="sub">avg <%= money(totals.orders ? totals.income / totals.orders : 0) %> per order</div></div>
  <div class="kpi"><span class="chip"><%- icon('wallet') %></span><div class="label">MoMo settled</div><div class="value"><%= money(totals.settled, 0) %></div><div class="sub">entered by Accounts</div></div>
  <div class="kpi <%= Math.abs(totals.variance) > tol.amt ? 'warn' : 'ok' %>"><div class="label">Variance</div><div class="value"><%= money(totals.variance, 0) %></div><div class="sub">settled − machine income</div></div>
  <div class="kpi <%= totals.unverified ? 'warn' : 'ok' %>"><div class="label">Awaiting verification</div><div class="value"><%= totals.unverified || 0 %></div><div class="sub">cash-ups</div></div>
</div>

<div class="grid g3">
  <div class="card span2"><div class="card-head"><h3>Daily income</h3><span class="small muted">As recorded from the machine portal</span></div>
    <%- chart({ type: 'bar', data: { labels: trend.map(t => fmtDate(t.day, {year:false})), datasets: [{ label: 'Income', data: trend.map(t => Math.round(t.revenue)), backgroundColor: '#E8501E', borderRadius: 8, maxBarThickness: 34 }] } }) %></div>
  <div class="card"><h3>By machine</h3>
    <% for (const m of byMachine) { const max = Math.max(1, ...byMachine.map(x => x.revenue)); %>
      <div style="margin:12px 0"><div class="small" style="display:flex;justify-content:space-between"><span><a href="/machines/<%= m.id %>"><b><%= m.code %></b></a> <span class="muted"><%= m.site_name.split('–')[0] %></span></span><b class="mono"><%= money(m.revenue, 0) %></b></div><div class="progress"><span style="width:<%= m.revenue / max * 100 %>%"></span></div></div>
    <% } %>
    <% if (byProduct.some(p => p.units)) { %><hr><div class="eyebrow" style="margin-bottom:8px">Flavours (where counts were recorded)</div>
      <% for (const p of byProduct.filter(p => p.units)) { %><div class="product-tile" style="margin-bottom:8px"><% if (p.image) { %><img src="<%= p.image %>" alt=""><% } %><div class="grow" style="flex:1"><b class="small"><%= p.name %></b><div class="small muted"><%= num(p.units) %> sold · <%= money(p.revenue, 0) %></div></div></div><% } %><% } %>
  </div>
</div>

<div class="card flush" style="margin-top:18px" id="cashups"><div class="card-head"><h3>Cash-ups</h3><a class="small" href="/reports/export/sales?from=<%= from %>&to=<%= to %>">Export CSV</a></div>
<form class="filterbar" method="get" style="margin:12px 20px;box-shadow:none"><input type="hidden" name="from" value="<%= from %>"><input type="hidden" name="to" value="<%= to %>"><input type="hidden" name="site" value="<%= site || '' %>">
  <div><label>Machine</label><select name="machine"><option value="">All</option><% for (const m of machines) { %><option value="<%= m.id %>" <%= selected(cf.machine, m.id) %>><%= m.code %></option><% } %></select></div>
  <div><label>Verified</label><select name="verified"><option value="">Any</option><option value="no" <%= selected(cf.verified, 'no') %>>Awaiting</option><option value="yes" <%= selected(cf.verified, 'yes') %>>Verified</option></select></div>
  <div><label>Variance</label><select name="variance"><option value="">Any</option><option value="big" <%= selected(cf.variance, 'big') %>>Above tolerance</option></select></div>
  <div><label>Portal status</label><select name="status"><option value="">Any</option><option value="online" <%= selected(cf.status, 'online') %>>Online</option><option value="offline" <%= selected(cf.status, 'offline') %>>Offline</option></select></div>
  <div class="fb-actions"><button class="btn primary sm">Filter</button><a class="btn sm" href="/sales?from=<%= from %>&to=<%= to %>#cashups">Reset</a></div></form>
<div class="table-wrap"><table class="table responsive"><thead><tr><th>Date</th><th>Machine</th><th class="num">Orders</th><th class="num">Machine income</th><th class="num">MoMo settled</th><th class="num">Variance</th><th>Portal status</th><th>Evidence</th><th>Verified</th></tr></thead><tbody>
<% for (const c of rows) { const big = isBig(c); %>
<tr><td data-label="Date" class="nowrap"><%= fmtDate(c.business_date, {year:false}) %></td>
<td data-label="Machine"><b><%= c.machine_code %></b><div class="small muted"><%= c.site_name.split('–')[0] %><%= c.supplier_device_no ? ' · ' + c.supplier_device_no : '' %></div></td>
<td class="num" data-label="Orders"><%= c.machine_reported_orders ?? '—' %></td>
<td class="num" data-label="Income"><b><%= money(c.machine_reported_amount) %></b></td>
<td class="num" data-label="Settled"><%= c.provider_settled_amount == null ? '—' : money(c.provider_settled_amount) %></td>
<td class="num" data-label="Variance" style="<%= big ? 'color:var(--bad);font-weight:700' : '' %>"><%= c.variance == null ? '—' : money(c.variance) %><% if (c.notes) { %><div class="small muted" style="font-weight:400;white-space:normal;max-width:220px"><%= c.notes %></div><% } %></td>
<td data-label="Portal status"><%- c.machine_status ? badge(c.machine_status) : '<span class="muted">—</span>' %></td>
<td data-label="Evidence"><% if (c.evidence) { %><a href="/uploads/<%= c.evidence %>" target="_blank">📷 view</a><% } else { %><span class="muted small">none</span><% } %></td>
<td data-label="Verified"><% if (c.verified_at) { %><%- badge('ok', c.verified_name) %><% } else if (can('payments.manage')) { %>
  <form method="post" action="/sales/closeouts/<%= c.id %>/verify" style="display:flex;gap:4px;flex-wrap:wrap;justify-content:flex-end"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (c.provider_settled_amount == null) { %><input name="provider_settled_amount" type="number" step="0.01" placeholder="Settled GH₵" style="padding:6px;width:110px"><% } %>
    <% if (big && !c.notes) { %><input name="notes" placeholder="Explain variance" style="padding:6px;width:140px"><% } %>
    <button class="btn sm ok">Verify</button></form>
<% } else { %><%- badge('pending') %><% } %>
<% if (can('sales.record') && !c.verified_at) { %> <a class="small" href="/sales/cashup?machine=<%= c.machine_id %>&date=<%= c.business_date %>">edit</a><% } %></td></tr>
<% } %></tbody></table></div><% if (!rows.length) { %><div class="empty">No cash-ups match.</div><% } %><%- include('../partials/pager', { p: cp, hash: 'cashups' }) %></div>
<p class="small muted" style="margin-top:12px">Supplier lets you export orders? <a href="/sales/import">Import an order CSV</a> for flavour-level detail (optional).</p>
