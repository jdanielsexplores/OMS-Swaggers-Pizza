<div class="page-head"><div><h1>Security log</h1><p>Sign-ins, failed attempts, lockouts, permission changes, geofence rejections and blocked access. Append-only — entries cannot be edited or deleted.</p></div><a class="btn" href="/admin/audit">Audit log</a></div>
<div class="kpis">
  <div class="kpi ok"><div class="label">Sign-ins (7d)</div><div class="value"><%= stats.ok || 0 %></div></div>
  <div class="kpi <%= stats.failed ? 'warn' : '' %>"><div class="label">Failed sign-ins</div><div class="value"><%= stats.failed || 0 %></div></div>
  <div class="kpi <%= stats.lockouts ? 'bad' : '' %>"><div class="label">Lockouts</div><div class="value"><%= stats.lockouts || 0 %></div></div>
  <div class="kpi"><div class="label">Geofence rejections</div><div class="value"><%= stats.geo || 0 %></div></div>
  <div class="kpi"><div class="label">Access denied</div><div class="value"><%= stats.denied || 0 %></div></div>
</div>
<form class="filterbar" method="get">
  <div><label>Search</label><input type="search" name="q" value="<%= f.q %>" placeholder="Identifier, details, IP"></div>
  <div><label>Event</label><select name="event"><option value="">All events</option><% for (const e of ['login','lockout','logout','timeout','password','permission','geofence','access','user']) { %><option value="<%= e %>" <%= selected(f.event, e) %>><%= titleCase(e) %></option><% } %></select></div>
  <div><label>User</label><select name="user"><option value="">Anyone</option><% for (const u of users) { %><option value="<%= u.id %>" <%= selected(f.user, u.id) %>><%= u.name %></option><% } %></select></div>
  <div><label>From</label><input type="date" name="from" value="<%= f.from %>"></div><div><label>To</label><input type="date" name="to" value="<%= f.to %>"></div>
  <div class="fb-actions"><button class="btn primary sm">Filter</button><a class="btn sm" href="/admin/security">Reset</a><a class="btn sm" href="/reports/export/security_log?from=<%= f.from %>&to=<%= f.to %>">CSV</a></div></form>
<div class="card flush"><div class="table-wrap"><table class="table responsive"><thead><tr><th>When</th><th>Event</th><th>User</th><th>Identifier</th><th>Details</th><th>IP / device</th></tr></thead><tbody>
<% for (const r of rows) { const bad = /failed|lockout|denied|rejected|blocked/.test(r.event); %><tr><td data-label="When" class="nowrap"><%= fmtDateTime(r.created_at) %></td><td data-label="Event"><%- badge(bad ? 'bad' : r.event.startsWith('login.success') ? 'ok' : 'info', r.event) %></td><td data-label="User"><%= r.name || '—' %></td><td data-label="Identifier" class="small"><%= r.identifier || '' %></td><td data-label="Details" class="small" style="max-width:320px;word-break:break-word"><%= (r.details || '').slice(0, 200) %></td><td data-label="IP" class="small muted"><%= r.ip || '' %><div><%= (r.user_agent || '').slice(0, 40) %></div></td></tr><% } %>
</tbody></table></div><% if (!rows.length) { %><div class="empty">No events match.</div><% } %><%- include('../partials/pager', { p }) %></div>
