<div class="page-head"><div><h1>Payment exceptions</h1><p>Money deducted but no order, duplicates, wrong amounts. Never ask a customer to pay again; never use a personal QR (SOP-03).</p></div>
</div>
<form class="filterbar" method="get">
  <div><label>Search</label><input type="search" name="q" value="<%= f.q %>" placeholder="Reference, last 4 digits"></div>
  <div><label>Status</label><select name="status"><% for (const st of ['open','all','investigating','matched','refunded','rejected','closed']) { %><option value="<%= st %>" <%= selected(status, st) %>><%= st === 'open' ? 'Open' : st === 'all' ? 'Any status' : titleCase(st) %></option><% } %></select></div>
  <div><label>Problem</label><select name="kind"><option value="">Any</option><% for (const k of ['deducted_no_order','duplicate','wrong_amount','pending','provider_down','unmatched']) { %><option value="<%= k %>" <%= selected(f.kind, k) %>><%= titleCase(k) %></option><% } %></select></div>
  <div><label>Machine</label><select name="machine"><option value="">All</option><% for (const m of machines) { %><option value="<%= m.id %>" <%= selected(f.machine, m.id) %>><%= m.code %></option><% } %></select></div>
  <div><label>From</label><input type="date" name="from" value="<%= f.from %>"></div><div><label>To</label><input type="date" name="to" value="<%= f.to %>"></div>
  <div class="fb-actions"><button class="btn primary sm">Filter</button><a class="btn sm" href="/payments">Reset</a></div></form>
<div class="grid g3">
  <div class="card"><h3>Record an exception</h3><form method="post" class="form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label>Machine</label><select name="machine_id"><% for (const m of machines) { %><option value="<%= m.id %>"><%= m.code %></option><% } %></select></div>
    <div><label>Problem</label><select name="kind"><option value="deducted_no_order">Money deducted, no order</option><option value="duplicate">Charged twice</option><option value="wrong_amount">Wrong amount</option><option value="pending">Pending / unclear</option><option value="provider_down">Provider down</option><option value="unmatched">Other / unmatched</option></select></div>
    <div class="form-row"><div><label>Amount (GHS)</label><input type="number" step="0.01" name="amount"></div><div><label>Phone last 4</label><input name="phone_last4" maxlength="4" inputmode="numeric"></div></div>
    <div><label>Payment reference</label><input name="payment_ref"></div><div><label>Order ID</label><input name="order_ref"></div><div><label>When</label><input type="datetime-local" name="occurred_at"></div>
    <div class="callout small">Record only the last 4 digits of the phone number. Never a PIN, OTP or card number.</div><button class="btn primary">Record</button></form></div>
  <div class="card span2 flush"><div class="table-wrap"><table class="table responsive"><thead><tr><th>When</th><th>Problem</th><th class="num">Amount</th><th>Ref</th><th>Status</th><th></th></tr></thead><tbody>
  <% for (const p of rows) { %><tr><td data-label="When"><%= fmtDateTime(p.occurred_at || p.created_at) %><div class="small muted"><%= p.site_name %> · <%= p.machine_code %></div></td><td data-label="Problem"><b><%= titleCase(p.kind) %></b><div class="small muted">by <%= p.reporter || '—' %><%= p.customer_phone_last4 ? ' · ****' + p.customer_phone_last4 : '' %><%= p.case_ref ? ' · ' + p.case_ref : '' %></div></td><td class="num" data-label="Amount"><%= p.amount == null ? '—' : money(p.amount) %></td><td data-label="Ref" class="small"><%= p.payment_ref || '—' %></td><td data-label="Status"><%- badge(p.status) %><div class="small"><%= p.resolution || '' %></div></td>
  <td><% if (can('payments.manage') && ['open','investigating'].includes(p.status)) { %><details><summary class="btn sm">Resolve</summary><form method="post" action="/payments/<%= p.id %>" class="form" style="margin-top:6px;min-width:220px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><option value="investigating">Investigating</option><option value="matched">Matched to order</option><option value="refunded">Refunded</option><option value="rejected">No issue found</option><option value="closed">Closed</option></select><input name="resolution" placeholder="Resolution"><label class="check small"><input type="checkbox" name="request_refund" value="1"> Request refund approval</label><button class="btn sm primary">Save</button></form></details><% } %></td></tr><% } %>
  </tbody></table></div><% if (!rows.length) { %><div class="empty">No payment exceptions match 🎉</div><% } %><%- include('../partials/pager', { p }) %></div>
</div>
