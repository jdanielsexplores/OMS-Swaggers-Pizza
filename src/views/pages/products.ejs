<div class="page-head"><div><h1>Menu & prices</h1><p>Only the Owner (or a manager with written authority) approves flavours, prices and promotions (SOP-10). Price changes by managers go to the Owner automatically.</p></div></div>
<% if (pending.length) { %><div class="callout">Waiting for approval: <%- pending.map(p => `<a href="/approvals/${p.id}">${esc(p.title)}</a>`).join(' · ') %></div><% } %>
<% for (const p of products) { %>
<form method="post" action="/admin/products/<%= p.id %>" class="card form" style="margin-bottom:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-head"><div class="product-tile"><% if (p.image) { %><img src="<%= p.image %>" alt="" style="width:64px;height:64px"><% } %><h3 style="margin:0"><%= p.name %> <span class="small muted mono"><%= p.sku %></span></h3></div><div class="actions"><%- p.approved ? badge('approved') : badge('pending','Awaiting approval') %><%- p.available ? badge('ok','On sale') : badge('closed','Unavailable') %></div></div>
  <div class="form-row"><div><label>Name</label><input name="name" value="<%= p.name %>"></div><div><label>Price (GHS)</label><input type="number" step="0.01" name="price" value="<%= p.price %>"></div><div><label>Unit cost (GHS)</label><input type="number" step="0.01" name="unit_cost" value="<%= p.unit_cost %>"></div><div><label>Margin</label><input disabled value="<%= pct(p.price ? (p.price - p.unit_cost) / p.price * 100 : null) %>"></div><div><label>Reorder level (machine)</label><input type="number" name="reorder_level" value="<%= p.reorder_level %>"></div></div>
  <div class="form-row"><div><label>Allergens (approved label only)</label><input name="allergens" value="<%= p.allergens || '' %>"></div><div><label>Shelf life (hours, once confirmed)</label><input type="number" name="shelf_life_hours" value="<%= p.shelf_life_hours ?? '' %>"></div><div><label>Storage note</label><input name="storage_note" value="<%= p.storage_note || '' %>"></div><div><label>Colour</label><input type="color" name="colour" value="<%= p.colour || '#d9480f' %>" style="height:42px;padding:3px"></div></div>
  <div><label>Description</label><input name="description" value="<%= p.description || '' %>"></div>
  <div class="actions"><label class="check"><input type="checkbox" name="available" value="1" <%= checked(p.available) %>> Available on machines</label><label class="check"><input type="checkbox" name="active" value="1" <%= checked(p.active) %>> Active</label><input name="reason" placeholder="Reason for any price change" style="max-width:300px"><button class="btn primary">Save</button></div></form>
<% } %>
<details class="card"><summary><b>+ Add a new flavour / product</b></summary>
<form method="post" action="/admin/products" class="form" style="margin-top:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-row"><div><label>SKU</label><input name="sku" required placeholder="PZ-SPICY"></div><div><label>Name</label><input name="name" required></div><div><label>Category</label><select name="category"><option value="pizza">Pizza</option><option value="packaging">Packaging</option><option value="consumable">Consumable</option></select></div><div><label>Price</label><input type="number" step="0.01" name="price"></div><div><label>Unit cost</label><input type="number" step="0.01" name="unit_cost"></div></div>
  <div class="form-row"><div><label>Allergens</label><input name="allergens"></div><div><label>Description</label><input name="description"></div><div><label>Colour</label><input type="color" name="colour" value="#d9480f" style="height:42px;padding:3px"></div></div>
  <div><button class="btn primary">Add product</button></div></form></details>
