<div class="page-head"><div><h1>Payroll <%= run.month %></h1><p><%= run.employees %> staff · generated <%= fmtDateTime(run.generated_at) %><%= run.finalized_at ? ' · finalised ' + fmtDateTime(run.finalized_at) : '' %></p></div>
  <div class="actions"><%- badge(run.status) %><a class="btn" href="/reports/export/payroll?from=<%= run.month %>-01&to=<%= run.month %>-28"><%- icon('download') %>CSV</a>
  <% if (run.status === 'draft') { %><form method="post" action="/payroll/generate" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="month" value="<%= run.month %>"><button class="btn">Recalculate</button></form>
  <form method="post" action="/payroll/<%= run.id %>/finalize" class="inline" data-confirm="Finalise and lock payroll for <%= run.month %>? Staff will be notified and the salary expense posted."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn primary">Finalise &amp; notify staff</button></form><% } %></div></div>
<div class="kpis"><div class="kpi"><div class="label">Gross</div><div class="value"><%= money(run.gross, 0) %></div></div><div class="kpi"><div class="label">Deductions</div><div class="value"><%= money(run.deductions, 0) %></div></div><div class="kpi ok"><div class="label">Net pay</div><div class="value"><%= money(run.net, 0) %></div></div></div>
<form class="filterbar" method="get"><div><label>Staff</label><input type="search" name="q" value="<%= f.q %>" placeholder="Name or staff no."></div>
  <div><label>Role</label><select name="role"><option value="">Any</option><% for (const r of ['ops_manager','supervisor','sales_rep','stock_staff','technician','accounts']) { %><option value="<%= r %>" <%= selected(f.role, r) %>><%= roleLabel(r) %></option><% } %></select></div>
  <div><label>Show</label><select name="absent"><option value="">Everyone</option><option value="1" <%= selected(f.absent, '1') %>>With absences</option></select></div>
  <div class="fb-actions"><button class="btn primary sm">Filter</button><a class="btn sm" href="/payroll/<%= run.id %>">Reset</a></div></form>
<div class="card flush"><div class="table-wrap"><table class="table responsive"><thead><tr><th>Staff</th><th class="num">Days (sched/worked)</th><th class="num">Absent</th><th class="num">Leave</th><th class="num">Late</th><th class="num">OT</th><th class="num">Base</th><th class="num">Allow.</th><th class="num">OT pay</th><th class="num">Deductions</th><th class="num">Net</th><th></th></tr></thead><tbody>
<% for (const i of items) { const ded = i.absence_deduction + i.late_deduction + i.ssnit + i.other_deductions; %><tr><td data-label="Staff"><b><%= i.name %></b><div class="small muted"><%= roleLabel(i.role) %> · <%= titleCase(i.pay_type) %></div></td><td class="num" data-label="Days"><%= i.scheduled_days %>/<%= i.worked_days %></td><td class="num" data-label="Absent" style="<%= i.absent_days ? 'color:var(--bad);font-weight:700' : '' %>"><%= i.absent_days %></td><td class="num" data-label="Leave"><%= i.leave_days %></td><td class="num" data-label="Late"><%= i.late_minutes %>m</td><td class="num" data-label="OT"><%= i.overtime_hours %>h</td><td class="num" data-label="Base"><%= money(i.base_pay, 0) %></td><td class="num" data-label="Allow."><%= money(i.allowances, 0) %></td><td class="num" data-label="OT pay"><%= money(i.overtime_pay, 0) %></td><td class="num" data-label="Deductions">−<%= money(ded, 0) %></td><td class="num" data-label="Net"><b><%= money(i.net) %></b></td><td><a class="btn sm" href="/payroll/slip/<%= i.id %>">Payslip</a></td></tr><% } %>
</tbody></table></div><%- include('../partials/pager', { p }) %></div>
<p class="small muted" style="margin-top:12px">Absences are scheduled working days (rostered shift or default schedule) with no attendance and no approved leave. Overtime = whole hours worked beyond the standard day plus grace.</p>
