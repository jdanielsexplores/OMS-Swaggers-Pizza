<div class="page-head"><div><h1>Stock ledger</h1><p>Every stock movement, who made it and when.</p></div><a class="btn" href="/reports/export/stock_movements"><%- icon('download') %>CSV</a></div>
<form class="filterbar" method="get">
  <div><label>Search</label><input type="search" name="q" value="<%= f.q %>" placeholder="Batch, reference, reason"></div>
  <div><label>Type</label><select name="kind"><option value="">All</option><% for (const k of ['receive','transfer','load','sale','waste','count','reject','adjust']) { %><option value="<%= k %>" <%= selected(f.kind, k) %>><%= titleCase(k) %></option><% } %></select></div>
  <div><label>Product</label><select name="product"><option value="">All</option><% for (const x of products) { %><option value="<%= x.id %>" <%= selected(f.product, x.id) %>><%= x.name %></option><% } %></select></div>
  <div><label>Location</label><select name="location"><option value="">All</option><% for (const l of locs) { %><option value="<%= l.id %>" <%= selected(f.location, l.id) %>><%= l.name %></option><% } %></select></div>
  <div><label>Staff</label><select name="staff"><option value="">Anyone</option><% for (const u of people) { %><option value="<%= u.id %>" <%= selected(f.staff, u.id) %>><%= u.name %></option><% } %></select></div>
  <div><label>From</label><input type="date" name="from" value="<%= f.from %>"></div><div><label>To</label><input type="date" name="to" value="<%= f.to %>"></div>
  <div class="fb-actions"><button class="btn primary sm">Filter</button><a class="btn sm" href="/stock/movements">Reset</a></div></form>
<div class="card flush"><div class="table-wrap"><table class="table responsive"><thead><tr><th>When</th><th>Type</th><th>Product</th><th>Batch</th><th class="num">Qty</th><th>From</th><th>To</th><th>Reason</th><th>By</th></tr></thead><tbody>
<% for (const m of rows) { %><tr><td data-label="When" class="nowrap"><%= fmtDateTime(m.occurred_at) %></td><td data-label="Type"><%- badge(m.kind === 'waste' || m.kind === 'reject' ? 'bad' : m.kind === 'sale' ? 'ok' : 'info', titleCase(m.kind)) %></td><td data-label="Product"><%= m.product_name %></td><td data-label="Batch" class="small"><%= m.batch_no || '—' %></td><td class="num" data-label="Qty"><%= num(m.qty) %></td><td data-label="From"><%= m.from_name || '—' %></td><td data-label="To"><%= m.to_name || '—' %></td><td data-label="Reason" class="small"><%= m.reason ? titleCase(m.reason) : '' %></td><td data-label="By"><%= m.user_name || 'system' %></td></tr><% } %>
</tbody></table></div><% if (!rows.length) { %><div class="empty">No movements match.</div><% } %><%- include('../partials/pager', { p }) %></div>
