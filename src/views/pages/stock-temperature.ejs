<div class="grid g3">
<div class="card"><h2>Log a temperature</h2><p class="small muted">Minimum 3 readings per machine per day: opening, mid-shift, closing (SOP-11). Approved range: <b><%= range.min %> to <%= range.max %>°C</b> (set by Manager until supplier confirms).</p>
<form method="post" class="form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div><label>Machine</label><select name="machine_id"><% for (const m of machines) { %><option value="<%= m.id %>"><%= m.code %> — <%= m.site_name %></option><% } %></select></div>
  <div><label>What was measured</label><select name="location_label"><option>Machine storage</option><option>Site freezer / fridge</option><option>Delivery cooler</option></select></div>
  <div><label>Reading (°C)</label><input type="number" step="0.1" name="reading" required inputmode="decimal" style="font-size:22px"></div>
  <div><label>Action taken (if out of range)</label><input name="action_taken"></div>
  <button class="btn primary lg">Save reading</button></form>
  <h4 style="margin-top:16px">Readings today</h4><div class="chips"><% for (const t of todayCounts) { %><span class="badge <%= t.n >= 3 ? 'ok' : t.n ? 'warn' : 'bad' %>"><%= t.code %>: <%= t.n %>/3</span><% } %></div></div>
<div class="card span2 flush"><div class="card-head"><h3>Temperature log</h3><a href="/reports/export/temperature_logs" class="small">Export CSV</a></div>
<form class="filterbar" method="get" style="margin:12px 16px;box-shadow:none">
  <div><label>Site</label><select name="site"><option value="">All</option><% for (const s of sites) { %><option value="<%= s.id %>" <%= selected(f.site, s.id) %>><%= s.name %></option><% } %></select></div>
  <div><label>Machine</label><select name="machine"><option value="">All</option><% for (const m of machines) { %><option value="<%= m.id %>" <%= selected(f.machine, m.id) %>><%= m.code %></option><% } %></select></div>
  <div><label>Result</label><select name="result"><option value="">Any</option><option value="bad" <%= selected(f.result, 'bad') %>>Out of range</option><option value="ok" <%= selected(f.result, 'ok') %>>In range</option></select></div>
  <div><label>From</label><input type="date" name="from" value="<%= f.from %>"></div><div><label>To</label><input type="date" name="to" value="<%= f.to %>"></div>
  <div class="fb-actions"><button class="btn primary sm">Filter</button><a class="btn sm" href="/stock/temperature">Reset</a></div></form><div class="table-wrap"><table class="table responsive"><thead><tr><th>When</th><th>Site / machine</th><th>What</th><th class="num">°C</th><th>Result</th><th>By</th></tr></thead><tbody>
<% for (const t of rows) { %><tr><td data-label="When"><%= fmtDateTime(t.recorded_at) %></td><td data-label="Site"><%= t.site_name %> <span class="muted small"><%= t.machine_code || '' %></span></td><td data-label="What"><%= t.location_label %></td><td class="num" data-label="°C"><b><%= t.reading %></b></td><td data-label="Result"><%- t.in_range ? badge('ok','In range') : badge('bad','OUT OF RANGE') %><div class="small"><%= t.action_taken || '' %></div></td><td data-label="By"><%= t.user_name %></td></tr><% } %>
</tbody></table></div><% if (!rows.length) { %><div class="empty">No readings match.</div><% } %><%- include('../partials/pager', { p }) %></div>
</div>
