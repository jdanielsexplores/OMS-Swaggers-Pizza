<div class="page-head"><div><h1>Payroll</h1><p>Generate the month's payroll in one click from attendance, overtime, approved leave, absences and each person's pay settings. Review, then finalise to lock it, notify staff and post the salary expense.</p></div></div>
<div class="grid g3">
  <div class="card"><h3>Generate payroll</h3>
    <form method="post" action="/payroll/generate" class="form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><label>Month</label><input type="month" name="month" value="<%= thisMonth %>" max="<%= thisMonth %>" required></div><button class="btn primary"><%- icon('banknote') %>Generate</button></form>
    <hr><div class="eyebrow" style="margin-bottom:8px">Current rates (Admin → Settings)</div>
    <dl class="dl small"><dt>Working days / month</dt><dd><%= rates.workingDays %></dd><dt>Standard day</dt><dd><%= rates.standardHours %> h</dd><dt>Overtime</dt><dd>× <%= rates.otMultiplier %></dd><dt>Lateness</dt><dd><%= rates.lateFreeMinutes %> free min, then <%= money(rates.latePerMinute) %>/min</dd><dt>SSNIT (employee)</dt><dd><%= rates.ssnitPct %>%</dd><dt>Deduct absences</dt><dd><%= rates.deductAbsence ? 'Yes' : 'No' %></dd></dl>
    <% if (missingPay.length) { %><div class="callout small"><b>No pay set for:</b> <% missingPay.forEach((u, i) => { %><a href="/users/<%= u.id %>#hr"><%= u.name %></a><%= i < missingPay.length - 1 ? ', ' : '' %><% }) %>. They are left out until a salary/rate is entered.</div><% } %></div>
  <div class="card span2 flush"><div class="card-head"><h3>History</h3><form method="get" class="actions"><select name="year" data-autosubmit style="width:auto;padding:6px 10px"><option value="">All years</option><% for (const y of years) { %><option value="<%= y %>" <%= selected(f.year, y) %>><%= y %></option><% } %></select><select name="status" data-autosubmit style="width:auto;padding:6px 10px"><option value="">Any status</option><option value="draft" <%= selected(f.status, 'draft') %>>Draft</option><option value="finalized" <%= selected(f.status, 'finalized') %>>Finalised</option></select></form></div><div class="table-wrap"><table class="table responsive"><thead><tr><th>Month</th><th class="num">Staff</th><th class="num">Gross</th><th class="num">Deductions</th><th class="num">Net</th><th>Status</th><th></th></tr></thead><tbody>
  <% for (const r of runs) { %><tr><td data-label="Month"><b><%= r.month %></b><div class="small muted">by <%= r.generated_name || '—' %> · <%= fmtDateTime(r.generated_at) %></div></td><td class="num" data-label="Staff"><%= r.employees %></td><td class="num" data-label="Gross"><%= money(r.gross, 0) %></td><td class="num" data-label="Deductions"><%= money(r.deductions, 0) %></td><td class="num" data-label="Net"><b><%= money(r.net, 0) %></b></td><td data-label="Status"><%- badge(r.status) %></td><td><a class="btn sm" href="/payroll/<%= r.id %>">Open</a></td></tr><% } %>
  </tbody></table></div><% if (!runs.length) { %><div class="empty">No payroll runs match.</div><% } %><%- include('../partials/pager', { p }) %></div>
</div>
