<div class="page-head"><div><h1>Tasks & corrective actions</h1><p>Every important activity has a responsible person and a due date.</p></div>
  <div class="actions"><% if (can('tasks.assign')) { %><a class="btn primary" href="/tasks/new"><%- icon('plus') %>Assign task</a><% } %></div></div>
<div class="tabs"><% for (const [k, l] of [['mine','Assigned to me'],['created','Created by me'],['all','All my sites']]) { %><a href="?view=<%= k %>" class="<%= view === k ? 'active' : '' %>"><%= l %></a><% } %></div>
<form class="filterbar" method="get"><input type="hidden" name="view" value="<%= view %>">
  <div><label>Search</label><input type="search" name="q" value="<%= f.q %>" placeholder="Task title or details"></div>
  <div><label>Status</label><select name="status"><option value="open" <%= selected(f.status, 'open') %>>Open</option><option value="done" <%= selected(f.status, 'done') %>>Completed</option><% for (const s of ['in_progress','verified','cancelled']) { %><option value="<%= s %>" <%= selected(f.status, s) %>><%= titleCase(s) %></option><% } %></select></div>
  <div><label>Priority</label><select name="priority"><option value="">Any</option><% for (const s of ['urgent','high','normal','low']) { %><option value="<%= s %>" <%= selected(f.priority, s) %>><%= titleCase(s) %></option><% } %></select></div>
  <div><label>Type</label><select name="kind"><option value="">Any</option><% for (const s of ['task','corrective_action','follow_up','project']) { %><option value="<%= s %>" <%= selected(f.kind, s) %>><%= titleCase(s) %></option><% } %></select></div>
  <div><label>Site</label><select name="site"><option value="">All</option><% for (const s of sites) { %><option value="<%= s.id %>" <%= selected(f.site, s.id) %>><%= s.name %></option><% } %></select></div>
  <% if (people.length) { %><div><label>Assignee</label><select name="assignee"><option value="">Anyone</option><% for (const u of people) { %><option value="<%= u.id %>" <%= selected(f.assignee, u.id) %>><%= u.name %></option><% } %></select></div><% } %>
  <div><label>Created from</label><input type="date" name="from" value="<%= f.from %>"></div><div><label>To</label><input type="date" name="to" value="<%= f.to %>"></div>
  <div><label>&nbsp;</label><label class="check" style="text-transform:none;letter-spacing:0;font-family:var(--font);font-size:13px;color:var(--ink-2)"><input type="checkbox" name="overdue" value="1" <%= checked(f.overdue === '1') %>> Overdue only</label></div>
  <div class="fb-actions"><button class="btn primary sm">Filter</button><a class="btn sm" href="/tasks?view=<%= view %>">Reset</a></div>
</form>
<div class="card flush"><% if (!rows.length) { %><div class="empty">Nothing here.</div><% } %><div class="table-wrap"><table class="table responsive"><thead><tr><th>Task</th><th>Priority</th><th>Assigned</th><th>Site</th><th>Due</th><th>Status</th></tr></thead><tbody>
<% for (const t of rows) { const late = t.due_at && t.due_at < sqlNow() && ['open','in_progress'].includes(t.status); %><tr><td data-label="Task"><a href="/tasks/<%= t.id %>"><b><%= t.title %></b></a><div class="small muted"><%= titleCase(t.kind) %><%= t.incident_ref ? ' · ' + t.incident_ref : '' %> · by <%= t.creator || '—' %></div></td><td data-label="Priority"><%- badge(t.priority) %></td><td data-label="Assigned"><%= t.assignee || '—' %></td><td data-label="Site"><%= t.site_name || '—' %></td><td data-label="Due"><%- late ? badge('overdue', fmtDateTime(t.due_at)) : (t.due_at ? fmtDateTime(t.due_at) : '—') %></td><td data-label="Status"><%- badge(t.status) %></td></tr><% } %>
</tbody></table></div><%- include('../partials/pager', { p }) %></div>
