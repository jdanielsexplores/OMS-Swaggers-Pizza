<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title ? title + ' · ' : '' %><%= businessName %></title>
  <meta name="theme-color" content="#E8501E">
  <% if (user) { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/img/icon-192.png" type="image/png">
  <link rel="apple-touch-icon" href="/img/icon-192.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/css/app.css?v=3">
  <% if (brand.color && brand.color !== '#E8501E') { %><style>:root{--brand:<%= brand.color %>;--brand-600:color-mix(in srgb,<%= brand.color %> 85%,#000);}</style><% } %>
  <script>try{var t=localStorage.getItem('swg-theme');document.documentElement.dataset.theme=t==='dark'?'dark':'light';}catch(e){}</script>
</head>
<body>
<% if (!user) { %>
  <%- body %>
<% } else {
  const nav = [
    { group: 'Workspace' },
    { href: '/', label: 'Staff Home', icon: 'home' },
    { href: '/dashboard', label: 'Operations', icon: 'dashboard', perm: 'dashboard.ops' },
    { href: '/owner', label: "Owner's View", icon: 'crown', perm: 'dashboard.owner' },
    { href: '/checklists', label: 'Checklists', icon: 'check', perm: 'checklists.use' },
    { href: '/incidents', label: 'Incidents', icon: 'alert', perm: 'incidents.view', count: criticalOpen, hot: true },
    { href: '/tasks', label: 'Tasks', icon: 'task' },
    { group: 'Operations' },
    { href: '/machines', label: 'Machines', icon: 'machine', perm: 'machines.view' },
    { href: machinePortalUrl, label: 'Machine Portal', icon: 'monitor', perm: 'machine_portal.open', external: true },
    { href: '/sales', label: 'Sales & Cash-up', icon: 'cash', perm: 'sales.view' },
    { href: '/stock', label: 'Stock & Food Safety', icon: 'box', perm: 'stock.use' },
    { href: '/customers', label: 'Customers', icon: 'heart', perm: 'customers.use' },
    { href: '/approvals', label: 'Approvals', icon: 'stamp', count: pendingApprovals },
    { group: 'People' },
    { href: '/attendance', label: 'Attendance', icon: 'clock' },
    { href: '/roster', label: 'Roster', icon: 'calendar', perm: 'roster.view' },
    { href: '/leave', label: 'Leave & Permissions', icon: 'flag' },
    { href: '/leaderboard', label: 'Leaderboard', icon: 'trophy', perm: 'leaderboard.view' },
    { href: '/payroll', label: 'Payroll', icon: 'banknote', perm: 'payroll.manage' },
    { href: '/payroll/my', label: 'My Payslips', icon: 'banknote', hideIf: 'payroll.manage' },
    { href: '/users', label: 'Staff', icon: 'users', perm: 'users.manage' },
    { href: '/training', label: 'Training', icon: 'grad', perm: 'training.use' },
    { href: '/handbook', label: 'Handbook & SOPs', icon: 'book', perm: 'handbook.view' },
    { href: '/assistant', label: 'Ask Swaggers', icon: 'sparkles', perm: 'assistant.use' },
    { group: 'Business' },
    { href: '/finance', label: 'Finance', icon: 'wallet', perm: 'finance.view' },
    { href: '/reports', label: 'Reports', icon: 'chart', perm: 'reports.view' },
    { href: '/sites', label: 'Sites & Expansion', icon: 'map', perm: 'sites.view' },
    { href: '/readiness', label: 'Launch Readiness', icon: 'rocket', perm: 'readiness.manage' },
    { href: '/access', label: 'Access & Roles', icon: 'key', perm: 'access.manage' },
    { href: '/admin', label: 'Admin & Settings', icon: 'settings', perm: 'audit.view' },
  ].filter((n) => (!n.perm || can(n.perm)) && !(n.hideIf && can(n.hideIf)));
  const isActive = (href) => href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
  const cleaned = nav.filter((n, i) => !n.group || (nav[i + 1] && !nav[i + 1].group));
%>
<div class="shell">
  <aside class="sidebar" id="sidebar">
    <a href="/" class="brand"><div class="brand-logo"><img src="<%= brand.logo %>" alt="<%= businessName %> logo"></div><div><b><%= businessName %></b><span><%= brand.tagline %></span></div></a>
    <nav class="nav">
      <% for (const n of cleaned) { if (n.group) { %><div class="nav-group"><%= n.group %></div><% continue; } %>
        <a href="<%= n.href %>" class="<%= !n.external && isActive(n.href) ? 'active' : '' %>" <%- n.external ? 'target="_blank" rel="noopener"' : '' %>><%- icon(n.icon) %><%= n.label %><% if (n.count) { %><span class="count <%= n.hot ? 'hot' : '' %>"><%= n.count %></span><% } %><% if (n.external) { %><%- icon('external', 'ext') %><% } %></a>
      <% } %>
    </nav>
    <div class="side-status" style="margin-top:20px">
      <div class="row"><span>Machines online</span><b><%= machineStats ? (machineStats.online || 0) + '/' + (machineStats.total || 0) : '—' %></b></div>
      <div class="row"><span>Critical incidents</span><b style="<%= criticalOpen ? 'color:#fca5a5' : '' %>"><%= criticalOpen %></b></div>
      <div class="row"><span>Your status</span><b style="color:<%= clockedIn ? '#86efac' : '#fcd34d' %>"><%= clockedIn ? 'On shift' : 'Off shift' %></b></div>
    </div>
    <div class="side-user">
      <div class="avatar"><%= initials %></div>
      <div class="who"><b><%= user.name %></b><span><%= roleLabel(user.role) %></span></div>
      <a href="/account" class="icon-btn" style="background:transparent;border-color:#2a2d36;color:#c9ccd4" title="My account"><%- icon('settings') %></a>
      <form method="post" action="/logout" id="logout-form" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-btn" style="background:transparent;border-color:#2a2d36;color:#c9ccd4" title="Sign out"><%- icon('logout') %></button></form>
    </div>
  </aside>
  <div class="main">
    <header class="topbar">
      <button class="icon-btn menu-btn" onclick="document.body.classList.toggle('nav-open')" aria-label="Menu"><%- icon('menu') %></button>
      <% if (backHref) { %><button class="back-btn" type="button" data-back="<%= backHref %>" aria-label="Go back"><%- icon('back') %><span>Back</span></button><% } %>
      <div class="titles"><div class="crumb"><%= fmtDate(today()) %></div><div class="title"><%= title %></div></div>
      <form class="search hide-sm" action="/search" method="get"><%- icon('search') %><input type="search" name="q" placeholder="Search staff, machines, SOPs, incidents…" value="<%= path === '/search' ? (query.q || '') : '' %>"></form>
      <a href="/attendance" class="shift-chip hide-sm <%= clockedIn ? 'on' : '' %>"><span class="pulse"></span><%= clockedIn ? 'On shift · ' + clockedIn.site_name : 'Not clocked in' %></a>
      <a href="/report" class="btn report-btn sm" style="height:38px"><%- icon('alert') %><span class="hide-sm">Report</span></a>
      <a href="/notifications" class="icon-btn" aria-label="Notifications"><%- icon('bell') %><% if (unread) { %><span class="dot"><%= unread > 99 ? '99+' : unread %></span><% } %></a>
      <button class="icon-btn hide-sm" onclick="toggleTheme()" aria-label="Toggle light / dark" title="Light / dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
      <a href="/account" class="avatar hide-sm" title="<%= user.name %>" style="text-decoration:none"><%= initials %></a>
    </header>
    <main class="content">
      <% for (const f of flash) { %><div class="flash <%= f.type %>"><%= f.msg %></div><% } %>
      <%- body %>
    </main>
  </div>
</div>
<nav class="bottom-nav">
  <a href="/" class="<%= path === '/' ? 'active' : '' %>"><%- icon('home') %>Home</a>
  <a href="/checklists" class="<%= path.startsWith('/checklists') ? 'active' : '' %>"><%- icon('check') %>Checklists</a>
  <a href="/report" class="report"><%- icon('alert') %>Report</a>
  <a href="/attendance" class="<%= path.startsWith('/attendance') ? 'active' : '' %>"><%- icon('clock') %>Attendance</a>
  <a href="/assistant" class="<%= path.startsWith('/assistant') ? 'active' : '' %>"><%- icon('sparkles') %>Ask</a>
</nav>
<% } %>
<script src="/js/app.js?v=5"></script>
</body>
</html>
