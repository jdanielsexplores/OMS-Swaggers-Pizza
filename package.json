{
  "name": "swaggers-oms",
  "version": "1.0.0",
  "description": "Swaggers Pizza Operations Management System — staff.swaggerspizza.com",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "seed:clean": "node --env-file-if-exists=.env src/db/seed.js --no-demo",
    "test": "rm -rf data/test.db* && DB_PATH=./data/test.db node -e \"require('./src/db/seed').run()\" && DB_PATH=./data/test.db node scripts/flow-test.js",
    "playbook": "node scripts/build-playbook.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "compression": "^1.8.2",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0"
  },
  "devDependencies": {
    "docx": "^9.10.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
